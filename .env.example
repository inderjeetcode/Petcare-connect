# ==============================================================================
# PET CONNECT — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env` or `.env.local`.
# NEVER expose private credentials or `service_role` keys in `VITE_*` variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Public Client Configuration (Browser-Safe)
# ------------------------------------------------------------------------------
# Local Supabase CLI default (after `supabase start`): http://127.0.0.1:54321
# Staging / Production: https://<project-ref>.supabase.co
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="your-local-or-env-supabase-anon-key"

# Optional Application URL (used in non-browser scripts / deployment metadata)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Isolated Local / CI Test Runner Credentials (NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
# Used ONLY by isolated local/staging CLI test runners (`scripts/test_controlled_rpc.cjs`).
# NEVER run against production and NEVER expose to browser bundles.
PETCONNECT_TEST_CLIENT_PASSWORD="replace-with-local-test-password"
PETCONNECT_TEST_ASSIGNED_DOCTOR_PASSWORD="replace-with-local-test-password"
PETCONNECT_TEST_OTHER_DOCTOR_PASSWORD="replace-with-local-test-password"
PETCONNECT_TEST_ADMIN_PASSWORD="replace-with-local-test-password"
